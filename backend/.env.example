# WooCommerce CRM Backend Configuration
PORT=5000

# WooCommerce REST API v3 Credentials
# Generated in WooCommerce > Settings > Advanced > REST API
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Demo Mode toggle: 'true' to use sample store data, 'false' for live store
DEMO_MODE=true
